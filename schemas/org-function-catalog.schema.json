{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-TownChain-Okosystems/atc-engineering/blob/main/schemas/org-function-catalog.schema.json",
  "title": "A-TownChain Organization Function Catalog",
  "description": "Source-bound discovery catalog. Schema validity does not imply completeness or verification.",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "observed_commit_sha",
    "generated_at",
    "status",
    "files",
    "symbols",
    "exclusions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "observed_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "DETECTED",
        "DOCUMENTED",
        "IMPLEMENTED",
        "VERIFIED",
        "STALE",
        "BLOCKED",
        "RESIDUAL",
        "FAILED"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "classification",
          "blob_sha",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "first_party",
              "test",
              "generated",
              "vendored",
              "archived",
              "documentation",
              "configuration",
              "unknown"
            ]
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "status": {
            "enum": [
              "ANALYSED",
              "SKIPPED",
              "PARSE_ERROR",
              "UNSUPPORTED"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "symbol_id",
          "repository",
          "path",
          "language",
          "symbol_kind",
          "qualified_name",
          "visibility",
          "source_start_line",
          "source_end_line",
          "source_blob_sha",
          "observed_commit_sha",
          "status",
          "component_id",
          "contract_refs",
          "limitations"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "symbol_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string"
          },
          "symbol_kind": {
            "type": "string",
            "minLength": 1
          },
          "qualified_name": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "private",
              "protected",
              "exported",
              "unknown"
            ]
          },
          "summary": {
            "type": "string"
          },
          "parameters": {
            "type": "array"
          },
          "return_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "type": "array"
          },
          "side_effects": {
            "type": "array"
          },
          "security_boundary": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "callers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "callees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doc_url_or_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_start_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_end_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "observed_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "status": {
            "enum": [
              "DETECTED",
              "DOCUMENTED",
              "IMPLEMENTED",
              "VERIFIED",
              "STALE",
              "BLOCKED",
              "RESIDUAL",
              "FAILED"
            ]
          },
          "canonical_owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "component_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "contract_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason_code",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "enum": [
              "READ_ERROR",
              "ARCHIVED",
              "VENDORED",
              "GENERATED",
              "UNSUPPORTED_FORMAT",
              "NON_UTF8",
              "PARSE_ERROR"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
